VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-hosken
# Para produção, configurar os valores do projeto e VITE_USE_EMULATORS=false.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-hosken.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-hosken.firebasestorage.app
VITE_FIREBASE_APP_ID=1:000000000000:web:demo-hosken
# Chave pública para notificações push; mantenha o valor real apenas no .env.local/GitHub Actions Variables.
VITE_FIREBASE_VAPID_KEY=
