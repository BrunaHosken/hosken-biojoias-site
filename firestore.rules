rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function text(value, limit) { return value is string && value.size() > 0 && value.size() <= limit; }
    function taxonomy(collectionName) {
      let data = request.resource.data;
      return (collectionName == 'collections'
          ? data.keys().hasOnly(['name','slug','status','description','imageUrls','imagePaths'])
            && (!('description' in data)
              || (data.description is string && data.description.size() <= 220))
            && ((!('imageUrls' in data) && !('imagePaths' in data))
              || (data.imageUrls is list
                && data.imagePaths is list
                && data.imageUrls.size() == data.imagePaths.size()
                && data.imageUrls.size() <= 6))
          : data.keys().hasOnly(['name','slug','status']))
        && text(data.name, 80) && text(data.slug, 80)
        && data.status in ['published','draft'];
    }
    match /{taxonomyCollection}/{id} {
      allow read: if taxonomyCollection in ['categories','collections','colors'] && (resource.data.status == 'published' || admin());
      allow create, update: if taxonomyCollection in ['categories','collections','colors'] && admin() && taxonomy(taxonomyCollection);
      allow delete: if taxonomyCollection in ['categories','collections','colors'] && admin();
    }
    match /products/{id} {
      allow read: if resource.data.status == 'published' || admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['name','description','priceCents','chainAddonPriceCents','withChainPriceCents','colorVariants','stock','lowStockThreshold','categoryId','collectionId','status','availability','imageUrl','imageUrls','imagePaths','materials','dimensions','careInstructions'])
        && text(request.resource.data.name, 120)
        && text(request.resource.data.description, 3000)
        && request.resource.data.priceCents is int && request.resource.data.priceCents >= 0
        && (!('withChainPriceCents' in request.resource.data)
          || (request.resource.data.withChainPriceCents is int && request.resource.data.withChainPriceCents >= 0))
        && (!('chainAddonPriceCents' in request.resource.data)
          || (request.resource.data.chainAddonPriceCents is int && request.resource.data.chainAddonPriceCents >= 0))
        && (!('colorVariants' in request.resource.data)
          || (request.resource.data.colorVariants is list && request.resource.data.colorVariants.size() <= 30))
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && (!('lowStockThreshold' in request.resource.data)
          || (request.resource.data.lowStockThreshold is int && request.resource.data.lowStockThreshold >= 0 && request.resource.data.lowStockThreshold <= 10000))
        && (!('imageUrls' in request.resource.data)
          || (request.resource.data.imageUrls is list && request.resource.data.imageUrls.size() <= 6))
        && (!('imagePaths' in request.resource.data)
          || (request.resource.data.imagePaths is list && request.resource.data.imagePaths.size() <= 6))
        && (!('materials' in request.resource.data)
          || (request.resource.data.materials is string && request.resource.data.materials.size() <= 500))
        && (!('dimensions' in request.resource.data)
          || (request.resource.data.dimensions is string && request.resource.data.dimensions.size() <= 300))
        && (!('careInstructions' in request.resource.data)
          || (request.resource.data.careInstructions is string && request.resource.data.careInstructions.size() <= 1500))
        && request.resource.data.status in ['published','draft']
        && request.resource.data.availability in ['available','soldout','paused','prelaunch','made-to-order']
        && ((request.resource.data.availability == 'available' && request.resource.data.stock > 0)
          || (request.resource.data.availability == 'soldout' && request.resource.data.stock == 0)
          || request.resource.data.availability in ['paused','prelaunch','made-to-order'])
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2000
        && exists(/databases/$(database)/documents/categories/$(request.resource.data.categoryId))
        && ((!('chainAddonPriceCents' in request.resource.data) && !('withChainPriceCents' in request.resource.data))
          || get(/databases/$(database)/documents/categories/$(request.resource.data.categoryId)).data.slug.matches('(^|.*-)colar(es)?(-.*|$)'))
        && exists(/databases/$(database)/documents/collections/$(request.resource.data.collectionId));
      allow delete: if admin();
    }
    match /productShipping/{productId} {
      function validShipping(data) {
        return data.keys().hasOnly([
            'packageLengthCm',
            'packageWidthCm',
            'packageHeightCm',
            'packageWeightGrams',
            'pieceWeightGrams'
          ])
          && data.keys().hasAll([
            'packageLengthCm',
            'packageWidthCm',
            'packageHeightCm',
            'packageWeightGrams'
          ])
          && data.packageLengthCm is number && data.packageLengthCm > 0
          && data.packageWidthCm is number && data.packageWidthCm > 0
          && data.packageHeightCm is number && data.packageHeightCm > 0
          && data.packageWeightGrams is number && data.packageWeightGrams > 0
          && (!('pieceWeightGrams' in data)
            || (data.pieceWeightGrams is number && data.pieceWeightGrams > 0));
      }
      allow read: if admin();
      allow create, update: if admin()
        && validShipping(request.resource.data)
        && (exists(/databases/$(database)/documents/products/$(productId))
          || existsAfter(/databases/$(database)/documents/products/$(productId)));
      allow delete: if admin();
    }
    match /faqs/{id} {
      function validFaq(data) {
        return data.keys().hasOnly(['title','body','status','category','keywords'])
          && data.keys().hasAll(['title','body','status','category'])
          && text(data.title, 160)
          && text(data.body, 5000)
          && text(data.category, 60)
          && (!('keywords' in data)
            || (data.keywords is string && data.keywords.size() <= 500))
          && data.status in ['published','draft'];
      }
      allow read: if resource.data.status == 'published' || admin();
      allow create, update: if admin() && validFaq(request.resource.data);
      allow delete: if admin();
    }
    match /{contentCollection}/{id} {
      allow read: if contentCollection in ['news','events','partnerStores','policies'] && (resource.data.status == 'published' || admin());
      allow create, update: if admin()
        && (contentCollection == 'events'
          ? request.resource.data.keys().hasOnly(['title','body','status','eventSchedule','eventDate','eventTime','location','address','mapUrl'])
            && text(request.resource.data.title, 160)
            && text(request.resource.data.body, 5000)
            && request.resource.data.status in ['published','draft']
            && (!('eventDate' in request.resource.data) || (request.resource.data.eventDate is string && request.resource.data.eventDate.size() <= 10))
            && (!('eventTime' in request.resource.data) || (request.resource.data.eventTime is string && request.resource.data.eventTime.size() <= 20))
            && (!('eventSchedule' in request.resource.data) || (request.resource.data.eventSchedule is list && request.resource.data.eventSchedule.size() <= 30))
            && (!('location' in request.resource.data) || (request.resource.data.location is string && request.resource.data.location.size() <= 160))
            && (!('address' in request.resource.data) || (request.resource.data.address is string && request.resource.data.address.size() <= 300))
            && (!('mapUrl' in request.resource.data) || (request.resource.data.mapUrl is string && request.resource.data.mapUrl.size() <= 2000))
          : contentCollection == 'policies'
            ? request.resource.data.keys().hasOnly(['title','body','status','policyType'])
              && request.resource.data.keys().hasAll(['policyType'])
              && text(request.resource.data.title, 160)
              && text(request.resource.data.body, 12000)
              && request.resource.data.policyType in ['delivery','reshipment','cancellation','returns','payment','privacy','general']
              && request.resource.data.status in ['published','draft']
            : contentCollection == 'partnerStores'
              ? request.resource.data.keys().hasOnly(['title','body','status','partnerType','location','address','mapUrl'])
                && request.resource.data.keys().hasAll(['partnerType','address'])
                && text(request.resource.data.title, 160)
                && text(request.resource.data.body, 5000)
                && request.resource.data.partnerType in ['partner_store','physical_store']
                && text(request.resource.data.address, 300)
                && (!('location' in request.resource.data) || (request.resource.data.location is string && request.resource.data.location.size() <= 160))
                && (!('mapUrl' in request.resource.data) || (request.resource.data.mapUrl is string && request.resource.data.mapUrl.size() <= 2000))
                && request.resource.data.status in ['published','draft']
            : contentCollection == 'news'
              && request.resource.data.keys().hasOnly(['title','body','status'])
              && text(request.resource.data.title, 160)
              && text(request.resource.data.body, 5000)
              && request.resource.data.status in ['published','draft']);
      allow delete: if contentCollection in ['news','events','partnerStores','policies'] && admin();
    }
    match /users/{uid} {
      function validProfile(data) {
        return data.keys().hasOnly(['displayName','phone','theme'])
          && (!('displayName' in data) || text(data.displayName, 100))
          && (!('phone' in data)
            || (data.phone is string && data.phone.matches('^[0-9]{11}$')))
          && (!('theme' in data) || data.theme in ['light','dark']);
      }
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data);
    }
    match /users/{uid}/savedAddresses/{addressId} {
      function validAddress(data) {
        return data.keys().hasOnly(['label','postalCode','street','number','complement','neighborhood','city','state'])
          && data.keys().hasAll(['label','postalCode','street','number','complement','neighborhood','city','state'])
          && text(data.label, 50)
          && data.postalCode is string && data.postalCode.matches('^[0-9]{5}-?[0-9]{3}$')
          && text(data.street, 160)
          && text(data.number, 20)
          && data.complement is string && data.complement.size() <= 100
          && text(data.neighborhood, 100)
          && text(data.city, 100)
          && data.state is string && data.state.matches('^[A-Z]{2}$');
      }
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && validAddress(request.resource.data);
    }
    // O backend cria pedidos e confirma pagamentos. A administração só altera
    // o andamento logístico e o código de rastreio.
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow create, delete: if false;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'trackingCode', 'updatedAt', 'reservationStatus', 'stockReserved'])
        && request.resource.data.status in ['pending_payment', 'confirmed', 'preparing', 'in_transit', 'completed', 'cancelled', 'refunded']
        && (!('trackingCode' in request.resource.data) || (request.resource.data.trackingCode is string && request.resource.data.trackingCode.size() <= 100))
        && (!('reservationStatus' in request.resource.data) || request.resource.data.reservationStatus in ['active', 'released', 'committed', 'not_applicable'])
        && (!('stockReserved' in request.resource.data) || request.resource.data.stockReserved is bool)
        && request.resource.data.updatedAt == request.time;
    }
    match /conversations/{conversationId} {
      function canAccessConversation() {
        return signedIn() && (conversationId == request.auth.uid || admin());
      }
      function messagePath(id) {
        return /databases/$(database)/documents/conversations/$(conversationId)/messages/$(id);
      }
      function messageHasValidImage(data) {
        return ('imageUrl' in data)
          && ('imagePath' in data)
          && data.senderId is string
          && text(data.imageUrl, 2048)
          && data.imagePath is string
          && data.imagePath.size() <= 500
          && data.imagePath.matches('^conversations/' + conversationId + '/' + data.senderId + '/[A-Za-z0-9_-]+[.]webp$');
      }
      function validMessageContent(data) {
        let imageFieldsPresent = ('imageUrl' in data) || ('imagePath' in data);
        let validImage = messageHasValidImage(data);
        return data.text is string
          && data.text.size() <= 2000
          && (data.text.size() > 0 || validImage)
          && (!imageFieldsPresent || validImage);
      }
      function messagePreview(data) {
        return data.text.size() > 0 ? data.text : '📷 Imagem';
      }
      function isMessageUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let message = getAfter(messagePath(request.resource.data.lastMessageId)).data;
        let customerMessage = request.resource.data.lastMessageSenderRole == 'customer';
        let adminMessage = request.resource.data.lastMessageSenderRole == 'admin';
        return signedIn()
          && resource.data.status == 'open'
          && changed.hasOnly(['lastMessage','lastMessageId','lastMessageSenderRole','updatedAt','unreadForAdmin','unreadForCustomer'])
          && changed.hasAll(['lastMessageId','updatedAt'])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() > 0
          && request.resource.data.lastMessage.size() <= 2000
          && request.resource.data.lastMessageId is string
          && request.resource.data.updatedAt == request.time
          && message.senderId == request.auth.uid
          && message.senderRole == request.resource.data.lastMessageSenderRole
          && messagePreview(message) == request.resource.data.lastMessage
          && message.createdAt == request.time
          && ((customerMessage
            && resource.data.customerId == request.auth.uid
              && changed.hasAll(['unreadForAdmin'])
              && request.resource.data.unreadForAdmin == resource.data.unreadForAdmin + 1
            && request.resource.data.unreadForCustomer == resource.data.unreadForCustomer)
            || (adminMessage
              && admin()
              && changed.hasAll(['unreadForCustomer'])
              && request.resource.data.unreadForCustomer == resource.data.unreadForCustomer + 1
              && request.resource.data.unreadForAdmin == resource.data.unreadForAdmin));
      }
      function isMessageEditUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let message = getAfter(messagePath(resource.data.lastMessageId)).data;
        return signedIn()
          && (resource.data.customerId == request.auth.uid || admin())
          && changed.hasOnly(['lastMessage','updatedAt'])
          && changed.hasAll(['updatedAt'])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() > 0
          && request.resource.data.lastMessage.size() <= 2000
          && request.resource.data.updatedAt == request.time
          && message.senderId == request.auth.uid
          && message.senderRole == resource.data.lastMessageSenderRole
          && messagePreview(message) == request.resource.data.lastMessage
          && message.editedAt == request.time
          && (request.time - message.createdAt) < duration.value(1, 'h');
      }
      function validMessageDeleteUpdate(messageId, changed) {
        let deleted = get(messagePath(messageId)).data;
        let removedUnreadForAdmin = deleted.senderRole == 'customer'
          && deleted.createdAt > resource.data.adminLastReadAt
          && resource.data.unreadForAdmin > 0;
        let removedUnreadForCustomer = deleted.senderRole == 'admin'
          && deleted.createdAt > resource.data.customerLastReadAt
          && resource.data.unreadForCustomer > 0;
        return deleted.senderId == request.auth.uid
          && (request.time - deleted.createdAt) < duration.value(1, 'h')
          && changed.hasOnly(['lastDeletedMessageId','lastMessage','lastMessageId','lastMessageSenderRole','updatedAt','unreadForAdmin','unreadForCustomer'])
          && changed.hasAll(['lastDeletedMessageId'])
          && ((removedUnreadForAdmin
            && changed.hasAll(['unreadForAdmin'])
            && request.resource.data.unreadForAdmin == resource.data.unreadForAdmin - 1
            && request.resource.data.unreadForCustomer == resource.data.unreadForCustomer)
            || (!removedUnreadForAdmin
              && !changed.hasAll(['unreadForAdmin'])
              && request.resource.data.unreadForAdmin == resource.data.unreadForAdmin
              && ((removedUnreadForCustomer
                && changed.hasAll(['unreadForCustomer'])
                && request.resource.data.unreadForCustomer == resource.data.unreadForCustomer - 1)
                || (!removedUnreadForCustomer
                  && !changed.hasAll(['unreadForCustomer'])
                  && request.resource.data.unreadForCustomer == resource.data.unreadForCustomer))))
          && ((resource.data.lastMessageId == request.resource.data.lastDeletedMessageId
            && changed.hasAll(['lastMessageId','lastMessageSenderRole','updatedAt'])
            && request.resource.data.updatedAt == request.time
            && ((request.resource.data.lastMessageId == ''
              && request.resource.data.lastMessage == ''
              && request.resource.data.lastMessageSenderRole == '')
              || (request.resource.data.lastMessageId != ''
                && messagePreview(getAfter(messagePath(request.resource.data.lastMessageId)).data) == request.resource.data.lastMessage
                && getAfter(messagePath(request.resource.data.lastMessageId)).data.senderRole == request.resource.data.lastMessageSenderRole)))
            || (resource.data.lastMessageId != request.resource.data.lastDeletedMessageId
              && !changed.hasAll(['lastMessage','lastMessageId','lastMessageSenderRole','updatedAt'])
              && request.resource.data.lastMessage == resource.data.lastMessage
              && request.resource.data.lastMessageId == resource.data.lastMessageId
              && request.resource.data.lastMessageSenderRole == resource.data.lastMessageSenderRole
              && request.resource.data.updatedAt == resource.data.updatedAt));
      }
      function isMessageDeleteUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let messageId = request.resource.data.lastDeletedMessageId;
        return signedIn()
          && (resource.data.customerId == request.auth.uid || admin())
          && messageId is string
          && messageId != resource.data.lastDeletedMessageId
          && exists(messagePath(messageId))
          && !existsAfter(messagePath(messageId))
          && validMessageDeleteUpdate(messageId, changed);
      }
      function markAdminRead() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return admin()
          && changed.hasOnly(['unreadForAdmin','adminLastReadAt'])
          && changed.hasAll(['adminLastReadAt'])
          && request.resource.data.unreadForAdmin == 0
          && request.resource.data.adminLastReadAt == request.time;
      }
      function markCustomerRead() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return signedIn()
          && resource.data.customerId == request.auth.uid
          && changed.hasOnly(['unreadForCustomer','customerLastReadAt'])
          && changed.hasAll(['customerLastReadAt'])
          && request.resource.data.unreadForCustomer == 0
          && request.resource.data.customerLastReadAt == request.time;
      }
      function startCustomerConversation() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return signedIn()
          && resource.data.customerId == request.auth.uid
          && resource.data.status in ['open','closed']
          && changed.hasOnly(['status','customerRequestedAt','customerRequestedTopic','updatedAt'])
          && changed.hasAll(['customerRequestedAt','customerRequestedTopic','updatedAt'])
          && request.resource.data.status == 'open'
          && request.resource.data.customerRequestedAt == request.time
          && request.resource.data.customerRequestedTopic in ['question','order','exchange','custom','pickup','other','product']
          && request.resource.data.updatedAt == request.time;
      }
      function closeCustomerConversation() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return signedIn()
          && (admin() || resource.data.customerId == request.auth.uid)
          && resource.data.status == 'open'
          && changed.hasOnly(['status','updatedAt'])
          && changed.hasAll(['status','updatedAt'])
          && request.resource.data.status == 'closed'
          && request.resource.data.updatedAt == request.time;
      }
      function validQuoteImage(data, index) {
        return data.imageUrls[index] is string
          && text(data.imageUrls[index], 2048)
          && data.imagePaths[index] is string
          && data.imagePaths[index].size() <= 500
          && data.imagePaths[index].matches('^conversations/' + conversationId + '/' + request.auth.uid + '/[A-Za-z0-9_-]+[.]webp$');
      }
      function validCustomQuoteImages(data) {
        return data.imageUrls is list
          && data.imagePaths is list
          && data.imageUrls.size() > 0
          && data.imageUrls.size() <= 4
          && data.imageUrls.size() == data.imagePaths.size()
          && validQuoteImage(data, 0)
          && (data.imageUrls.size() < 2 || validQuoteImage(data, 1))
          && (data.imageUrls.size() < 3 || validQuoteImage(data, 2))
          && (data.imageUrls.size() < 4 || validQuoteImage(data, 3));
      }
      function validCustomQuoteOffer() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'customerId','title','description','categoryId','categoryName','categorySlug',
            'colorIds','colorNames','imageUrls','imagePaths','basePriceCents','chainAddonPriceCents',
            'status','createdAt','updatedAt'
          ])
          && data.keys().hasAll([
            'customerId','title','description','categoryId','categoryName','categorySlug',
            'colorIds','colorNames','basePriceCents','status','createdAt','updatedAt'
          ])
          && data.customerId == get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId
          && text(data.title, 100)
          && text(data.description, 1500)
          && text(data.categoryId, 150)
          && text(data.categoryName, 80)
          && text(data.categorySlug, 80)
          && data.colorIds is list
          && data.colorIds.size() <= 20
          && data.colorNames is map
          && data.colorNames.size() == data.colorIds.size()
          && data.basePriceCents is int
          && data.basePriceCents > 0
          && data.basePriceCents <= 100000000
          && data.status == 'offered'
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && (('imageUrls' in data) == ('imagePaths' in data))
          && (!('imageUrls' in data) || validCustomQuoteImages(data))
          && (!('chainAddonPriceCents' in data)
            || (data.chainAddonPriceCents is int
              && data.chainAddonPriceCents > 0
              && data.chainAddonPriceCents <= 100000000
              && exists(/databases/$(database)/documents/categories/$(data.categoryId))
              && get(/databases/$(database)/documents/categories/$(data.categoryId)).data.slug.matches('(^|.*-)colar(es)?(-.*|$)')));
      }
      function validCustomQuoteAcceptance() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let selectedColorRequired = resource.data.colorIds.size() > 0;
        return signedIn()
          && resource.data.customerId == request.auth.uid
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerId == request.auth.uid
          && resource.data.status == 'offered'
          && changed.hasOnly(['status','selectedColorId','withChain','acceptedAt','updatedAt'])
          && changed.hasAll(['status','withChain','acceptedAt','updatedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.withChain is bool
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.updatedAt == request.time
          && (selectedColorRequired
            ? (request.resource.data.selectedColorId is string
              && request.resource.data.selectedColorId in resource.data.colorIds)
            : !('selectedColorId' in request.resource.data))
          && (!request.resource.data.withChain
            || (('chainAddonPriceCents' in resource.data)
              && resource.data.categorySlug.matches('(^|.*-)colar(es)?(-.*|$)')));
      }
      allow read: if admin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn()
        && conversationId == request.auth.uid
        && request.resource.data.keys().hasOnly(['customerId','customerName','customerEmail','status','lastMessage','lastMessageId','lastMessageSenderRole','lastDeletedMessageId','unreadForAdmin','unreadForCustomer','customerRequestedAt','customerRequestedTopic','adminLastReadAt','customerLastReadAt','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['customerId','customerName','customerEmail','status','lastMessage','lastMessageId','lastMessageSenderRole','lastDeletedMessageId','unreadForAdmin','unreadForCustomer','adminLastReadAt','customerLastReadAt','createdAt','updatedAt'])
        && request.resource.data.customerId == request.auth.uid
        && text(request.resource.data.customerName, 100)
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.size() <= 254
        && request.resource.data.status == 'open'
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() == 0
        && request.resource.data.lastMessageId == ''
        && request.resource.data.lastMessageSenderRole == ''
        && request.resource.data.lastDeletedMessageId == ''
        && request.resource.data.unreadForAdmin == 0
        && request.resource.data.unreadForCustomer == 0
        && request.resource.data.adminLastReadAt == request.time
        && request.resource.data.customerLastReadAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!('customerRequestedAt' in request.resource.data)
          || (request.resource.data.customerRequestedAt == request.time
            && 'customerRequestedTopic' in request.resource.data
            && request.resource.data.customerRequestedTopic in ['question','order','exchange','custom','pickup','other','product']))
        && (!('customerRequestedTopic' in request.resource.data)
          || ('customerRequestedAt' in request.resource.data));
      // Keep low-cost conversation actions first. Message updates perform
      // several getAfter checks and can hit Firestore's rule-expression limit
      // if evaluated for a simple reopen/close/read update.
      allow update: if startCustomerConversation()
        || closeCustomerConversation()
        || markCustomerRead()
        || markAdminRead()
        || isMessageUpdate()
        || isMessageEditUpdate()
        || isMessageDeleteUpdate();
      allow delete: if false;

      match /quotes/{quoteId} {
        allow read: if admin()
          || (signedIn() && resource.data.customerId == request.auth.uid);
        allow create: if admin() && validCustomQuoteOffer();
        allow update: if validCustomQuoteAcceptance();
        allow delete: if false;
      }

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function conversationAfter() {
          return getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function editableByAuthor() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return signedIn()
            && resource.data.senderId == request.auth.uid
            && (request.time - resource.data.createdAt) < duration.value(1, 'h')
            && changed.hasOnly(['text','editedAt','imageUrl','imagePath'])
            && changed.hasAll(['text','editedAt'])
            && validMessageContent(request.resource.data)
            && request.resource.data.editedAt == request.time
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.senderRole == resource.data.senderRole
            && request.resource.data.createdAt == resource.data.createdAt
            && (conversation().lastMessageId != messageId
              || (conversationAfter().lastMessageId == messageId
                && conversationAfter().lastMessage == messagePreview(request.resource.data)));
        }
        allow read: if canAccessConversation();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['senderId','senderRole','text','createdAt','imageUrl','imagePath'])
          && request.resource.data.keys().hasAll(['senderId','senderRole','text','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && validMessageContent(request.resource.data)
          && request.resource.data.createdAt == request.time
          && canAccessConversation()
          && conversationAfter().lastMessageId == messageId
          && conversationAfter().lastMessage == messagePreview(request.resource.data)
          && ((request.resource.data.senderRole == 'customer'
              && conversationId == request.auth.uid)
            || (request.resource.data.senderRole == 'admin' && admin()));
        allow update: if editableByAuthor();
        allow delete: if signedIn()
          && resource.data.senderId == request.auth.uid
          && (request.time - resource.data.createdAt) < duration.value(1, 'h')
          && conversationAfter().lastDeletedMessageId == messageId;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
